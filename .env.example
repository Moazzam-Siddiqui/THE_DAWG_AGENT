# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./data/dawg_agent.db
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
OUTPUT_DIR=assets/rendered

# Safety / scheduling
PUBLISH_ENABLED=false
REQUIRE_APPROVAL=true
MAX_POSTS_PER_DAY=3
MIN_POST_INTERVAL_MINUTES=180
PUBLISH_WINDOW_START=07:00
PUBLISH_WINDOW_END=22:00
SCHEDULER_POLL_SECONDS=30
MAX_RETRIES=3

# Render
FFMPEG_BINARY=ffmpeg
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
DEFAULT_DURATION_SECONDS=9
MAX_DURATION_SECONDS=12
USE_AUDIO_BY_DEFAULT=true
AUDIO_REQUIRED=false
AUDIO_SOURCE_PATH=

# Cloudinary (cloud name/preset are not secrets; never put API secret in Git)
CLOUDINARY_CLOUD_NAME=tlrvr5kk
CLOUDINARY_UPLOAD_PRESET=dog_reels_upload
CLOUDINARY_FOLDER=dog-reels

# Instagram Graph API
META_GRAPH_VERSION=v23.0
INSTAGRAM_USER_ID=
META_ACCESS_TOKEN=

# Optional webhook/API protection
API_KEY=
