DATABASE_URL=sqlite:///./data/dawg_agent.db
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
OUTPUT_DIR=assets/rendered

# Automatic publishing is opt-in. Enable only after Meta credentials and test setup.
PUBLISH_ENABLED=false
REQUIRE_APPROVAL=false
MAX_POSTS_PER_DAY=3
MIN_POST_INTERVAL_MINUTES=180
PUBLISH_WINDOW_START=07:00
PUBLISH_WINDOW_END=22:00
SCHEDULER_POLL_SECONDS=30
MAX_RETRIES=3

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MAX_DURATION_SECONDS=12
DEFAULT_DURATION_SECONDS=9
AUDIO_REQUIRED=true
AUDIO_SOURCE_PATH=assets/audio/what_da_dog_doing.mp3

# Google Drive for desktop: point this at a folder inside your synced My Drive.
DRIVE_INBOX_DIR=drive/01_INCOMING_IMAGES
DRIVE_PROCESSED_DIR=drive/04_PROCESSED_IMAGES
DRIVE_FAILED_DIR=drive/05_FAILED_IMAGES
DEFAULT_CAPTION=What da dog doin? 🐶
DEFAULT_HASHTAGS=["dogs","dogreels","WhatDaDogDoing","TeachAltmanALesson"]

# Meta Instagram Graph API. Resumable local-file upload requires Facebook Login for Business.
META_GRAPH_VERSION=v23.0
INSTAGRAM_USER_ID=
META_ACCESS_TOKEN=
INSTAGRAM_PROCESSING_ATTEMPTS=60
INSTAGRAM_PROCESSING_POLL_SECONDS=5
API_KEY=
